<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>demo-taf-tests</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>demo-taf-tests</name>
    <description>Test automation framework (TAF) demo: data clients, keywords and Selenium page objects</description>

    <organization>
        <name>Nagarro GmbH</name>
    </organization>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Florin Balint</name>
            <organization>Nagarro GmbH</organization>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <!-- JUnit 6 requires Java 17 or newer -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- library versions -->
        <junit.version>6.1.3</junit.version>
        <selenium.version>4.52.0</selenium.version>

        <!-- plugin versions -->
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    </properties>

    <!-- The JUnit BOM keeps all JUnit modules on the same version -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
      Note the scopes: the FRAMEWORK lives in src/main/java, so the libraries it uses (Selenium and the
      JUnit API for the base test class) are normal "compile" dependencies – not only "test".
    -->
    <dependencies>
        <!-- JUnit 6 API: @BeforeEach/@AfterEach in the framework's base test class (src/main) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <!-- JUnit 6 complete (engine + @ParameterizedTest): runs the test cases (src/test) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Selenium WebDriver for Google Chrome. The matching ChromeDriver is downloaded automatically
          by "Selenium Manager" (built into Selenium) on the first run and cached in ~/.cache/selenium.
        -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-chrome-driver</artifactId>
            <version>${selenium.version}</version>
        </dependency>
        <!-- WebDriverWait / ExpectedConditions: wait until an element is visible or clickable -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-support</artifactId>
            <version>${selenium.version}</version>
        </dependency>
    </dependencies>

    <build>
        <!-- Run all tests with: mvn clean test      Without a visible browser: mvn clean test -Dbrowser.headless=true -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${maven-compiler-plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
